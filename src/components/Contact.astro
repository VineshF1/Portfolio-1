---
import { Icon } from 'astro-icon/components';
import Split from './Split.astro';
import { site } from '../data/site';

const { contact, links, identity } = site;
---

<section class="section" id={contact.id} aria-labelledby="contact-title">
  <div class="shell">
    <header class="sec-head">
      <p class="sec-index mono">{contact.index}</p>
      <span class="sec-rule" data-rule aria-hidden="true"></span>
      <h2 class="sec-title" id="contact-title" data-split-head>
        <Split text="Contact" />
      </h2>
    </header>

    <p class="contact-statement" data-split-head>
      <Split text={contact.statement} />
    </p>

    <p class="contact-sub" data-reveal>{contact.sub}</p>

    <div class="contact-actions" data-reveal>
      <a class="contact-mail" href={`mailto:${links.email}`}>{links.email}</a>
      <button class="copy-btn" type="button" data-copy={links.email} aria-label={`Copy email address ${links.email}`}>
        <Icon name="solar:copy-linear" class="icon icon-copy" size={18} aria-hidden="true" />
        <Icon name="solar:check-circle-linear" class="icon icon-check" size={18} aria-hidden="true" />
      </button>
      <a class="btn btn-ghost" href={links.github} target="_blank" rel="noopener noreferrer">
        GitHub
        <Icon name="solar:arrow-right-up-linear" class="icon" size={16} aria-hidden="true" />
      </a>
      <a class="btn btn-ghost" href={links.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn
        <Icon name="solar:arrow-right-up-linear" class="icon" size={16} aria-hidden="true" />
      </a>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </div>

    <p class="contact-note mono" data-reveal>
      <span class="dot" aria-hidden="true"></span>
      {contact.note}{identity.location ? ` — ${identity.location}` : ''}
    </p>
  </div>
</section>
